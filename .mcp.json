{
  "mcpServers": {
    "wandb": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/wandb/wandb-mcp-server",
        "--with",
        "mcp>=1.6,<2",
        "wandb_mcp_server"
      ],
      "env": {
        "WANDB_API_KEY": "${WANDB_API_KEY}"
      }
    }
  }
}